<Window x:Class="ExamApp.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
Title="Демо-экзамен. Вариант 1"
Height="713" Width="500"
WindowStartupLocation="CenterScreen"
TextElement.Foreground="{DynamicResource MaterialDesignBody}"
Background="{DynamicResource MaterialDesignPaper}">
    <Viewbox>
        <StackPanel>
        <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0"
 Text="Расчёт баллов демо-экзамена"
 FontSize="20"
 FontWeight="Bold"
 Margin="0,0,0,16"
 HorizontalAlignment="Center"/>
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="Уровень экзамена:"
 FontWeight="Bold"
 Margin="0,0,0,8"/>
            <RadioButton x:Name="rbBU"
 GroupName="ExamLevel"
 Content="Базовый (БУ) — модули 1–3"
 IsChecked="True"
 Checked="Level_Changed"
 Margin="0,2"/>
            <RadioButton x:Name="rbPU"
 GroupName="ExamLevel"
 Content="Профильный (ПУ) — модули 1–4"
 Checked="Level_Changed"
 Margin="0,2"/>
            <RadioButton x:Name="rbPUPlus"
 GroupName="ExamLevel"
 Content="Профильный + вариатив (ПУ+) — модули 1–5"
 Checked="Level_Changed"
 Margin="0,2"/>
        </StackPanel>
        <Border Grid.Row="2"
BorderBrush="{DynamicResource MaterialDesignDivider}"
BorderThickness="0,0,0,1"
Padding="0,0,0,8"
Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Введите баллы за модули:"
 FontWeight="Bold"
 Margin="0,0,0,8"/>
                <TextBox x:Name="txtModule1"
 Text="0"
 Style="{StaticResource MaterialDesignFilledTextBox}"
 Margin="0,0,0,8"
 materialDesign:HintAssist.Hint="Модуль 1 (макс. 10)"/>
                <TextBox x:Name="txtModule2"
 Text="0"
 Style="{StaticResource MaterialDesignFilledTextBox}"
 Margin="0,0,0,8"
 materialDesign:HintAssist.Hint="Модуль 2 (макс. 15)"/>
                <TextBox x:Name="txtModule3"
 Text="0"
 Style="{StaticResource MaterialDesignFilledTextBox}"
 Margin="0,0,0,8"
 materialDesign:HintAssist.Hint="Модуль 3 (макс. 25)"/>
                <TextBox x:Name="txtModule4"
 Text="0"
 Style="{StaticResource MaterialDesignFilledTextBox}"
 Margin="0,0,0,8"
 materialDesign:HintAssist.Hint="Модуль 4 (макс. 25)"/>
                <TextBox x:Name="txtModule5"
 Text="0"
 Style="{StaticResource MaterialDesignFilledTextBox}"
 Margin="0,0,0,8"
 materialDesign:HintAssist.Hint="Модуль 5 (макс. 25)"/>
            </StackPanel>
        </Border>
        <Button Grid.Row="3"
Content="РАССЧИТАТЬ"
Click="Calculate_Click"
Style="{StaticResource MaterialDesignRaisedButton}"
Margin="0,0,0,16"
Height="40"/>
        <Border Grid.Row="4"
Background="{DynamicResource MaterialDesignCardBackground}"
CornerRadius="8"
Padding="12"
Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Результат:"
 FontWeight="Bold"
 Margin="0,0,0,8"/>
                <TextBlock x:Name="txtSum"
 Text="Сумма баллов: —"
 FontSize="14"
 Margin="0,0,0,4"/>
                <TextBlock x:Name="txtGrade"
 Text="Оценка: —"
 FontSize="14"
 FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="5"
 x:Name="txtMaxInfo"
 Text="Максимум текущего уровня: 50"
 FontSize="12"
 Foreground="{DynamicResource MaterialDesignBodyLight}"
 TextWrapping="Wrap"/>
    </Grid>
    </StackPanel>
    </Viewbox>
</Window>